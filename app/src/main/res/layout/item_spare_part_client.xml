<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvPartName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Nombre del Repuesto"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/geist_medium" />

    <TextView
        android:id="@+id/tvPartQty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:text="x1"
        android:textColor="@color/cadet_grey"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPartPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textColor="@color/status_finished"
        android:textSize="14sp"
        android:fontFamily="@font/geist_bold" />
</LinearLayout>
