<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chinese_black">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chinese_black"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back_modern"
            app:navigationIconTint="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aprobación del cliente"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/ivToolbarSave"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/ube" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Order Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/american_blue"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0.5dp"
                app:strokeColor="@color/cadet_grey">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_nav_item_selected_pill"
                        android:padding="8dp"
                        android:src="@drawable/ic_nav_orders"
                        app:tint="@color/chinese_black" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOrderNumDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orden: OT-00025"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/geist_bold" />

                        <TextView
                            android:id="@+id/tvClientDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cliente: ACME S.A.S"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvEquipDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Equipo: Split Inverter 24K"
                            android:textColor="@color/cadet_grey"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="FINALIZADA"
                        android:textColor="@color/status_finished"
                        android:textSize="10sp"
                        android:fontFamily="@font/geist_bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resumen del servicio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Resumen del servicio"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/american_blue"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0.5dp"
                app:strokeColor="@color/cadet_grey">
                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Cargando detalles..."
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/geist" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Observaciones del cliente -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Observaciones del cliente"
                app:counterEnabled="true"
                app:counterMaxLength="250">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textColor="@color/white"
                    android:fontFamily="@font/geist"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nombre del cliente -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nombre del cliente *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:fontFamily="@font/geist"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Aceptación del servicio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Aceptación del servicio *"
                android:textColor="@color/cadet_grey"
                android:textSize="12sp"
                android:fontFamily="@font/geist_medium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/status_finished_container"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAccept"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="El cliente acepta el servicio realizado"
                    android:textColor="@color/status_finished"
                    android:fontFamily="@font/geist_bold"
                    android:textSize="13sp"
                    app:thumbTint="@color/status_finished"
                    app:trackTint="@color/status_finished" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Firma del cliente -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Firma del cliente"
                    android:textColor="@color/cadet_grey"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist_medium" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSignature"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIMPIAR"
                    android:textColor="@color/ube"
                    android:textSize="11sp"
                    android:fontFamily="@font/geist_bold"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconSize="14dp"
                    app:iconTint="@color/ube" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/cadet_grey"
                app:strokeWidth="0.5dp">

                <com.example.climatrack.utils.SignatureView
                    android:id="@+id/signatureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón Guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveApproval"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="100dp"
                android:text="✓ GUARDAR APROBACIÓN"
                android:fontFamily="@font/geist_bold"
                android:textSize="15sp"
                app:backgroundTint="@color/status_finished"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>