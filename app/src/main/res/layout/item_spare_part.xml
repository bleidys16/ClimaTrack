<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/cadet_grey"
    app:cardBackgroundColor="@color/american_blue">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivPartIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="8dp"
            android:src="@drawable/ic_nav_equipment"
            app:tint="@color/chinese_black"
            android:background="@drawable/bg_nav_item_selected_pill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvPartCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="RPT-0007"
            android:textColor="@color/ube"
            android:fontFamily="@font/geist_bold"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/ivPartIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPartName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Filtro de aire lavable"
            android:textColor="@color/white"
            android:fontFamily="@font/geist_medium"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvPartCode"
            app:layout_constraintTop_toBottomOf="@id/tvPartCode"
            app:layout_constraintEnd_toStartOf="@id/tvPartUnit" />

        <TextView
            android:id="@+id/tvPartQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad: 2"
            android:textColor="@color/cadet_grey"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvPartCode"
            app:layout_constraintTop_toBottomOf="@id/tvPartName" />

        <TextView
            android:id="@+id/tvPartUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unidad"
            android:textColor="@color/cadet_grey"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/ivMenuMore"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvPartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 25.000"
            android:textColor="@color/ube"
            android:fontFamily="@font/geist_bold"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/ivMenuMore"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/cadet_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>