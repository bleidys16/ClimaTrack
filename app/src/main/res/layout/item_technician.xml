<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/american_blue"
    app:cardCornerRadius="16dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/cadet_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivTechAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/perfil_tecnico"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTechName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Técnico"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/geist_bold" />

            <TextView
                android:id="@+id/tvTechStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 trabajos realizados"
                android:textColor="@color/cadet_grey"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/status_pending_container"
            app:cardCornerRadius="8dp"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvTechStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="INACTIVO"
                android:textColor="@color/status_pending"
                android:textSize="10sp"
                android:fontFamily="@font/geist_bold" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
