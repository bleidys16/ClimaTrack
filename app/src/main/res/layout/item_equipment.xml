<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/cadet_grey"
    app:cardBackgroundColor="@color/american_blue">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgEquipment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_nav_equipment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ube" />

        <TextView
            android:id="@+id/tvEquipCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/geist_bold"
            android:text="EQ-001"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/tvEquipStatus"
            app:layout_constraintStart_toEndOf="@id/imgEquipment"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEquipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="OPERATIVO"
            android:textColor="@color/status_finished"
            android:textSize="10sp"
            android:fontFamily="@font/geist_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEquipType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geist_medium"
            android:text="Aire Acondicionado Central"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvEquipCode"
            app:layout_constraintTop_toBottomOf="@id/tvEquipCode" />

        <TextView
            android:id="@+id/tvEquipBrandModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist"
            android:text="York YXC-48"
            android:textColor="@color/cadet_grey"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvEquipCode"
            app:layout_constraintTop_toBottomOf="@id/tvEquipType" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>