<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/cadet_grey"
    app:cardBackgroundColor="@color/american_blue">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgOrder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_nav_orders"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ube" />

        <TextView
            android:id="@+id/tvOrderNum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/geist_bold"
            android:text="OT-00001"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/imgOrder"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="PENDIENTE"
            android:textColor="@color/status_pending"
            android:textSize="10sp"
            android:fontFamily="@font/geist_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvClientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geist_medium"
            android:text="Cliente: Hotel del Mar"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvOrderNum"
            app:layout_constraintTop_toBottomOf="@id/tvOrderNum" />

        <TextView
            android:id="@+id/tvEquipmentInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist"
            android:text="Equipo: Aire Central York"
            android:textColor="@color/cadet_grey"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvOrderNum"
            app:layout_constraintTop_toBottomOf="@id/tvClientName" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"
            android:background="@color/cadet_grey"
            android:alpha="0.3"
            app:layout_constraintTop_toBottomOf="@id/tvEquipmentInfo" />

        <ImageView
            android:id="@+id/imgCalendar"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:tint="@color/cadet_grey" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/geist"
            android:text="2026-08-19"
            android:textColor="@color/cadet_grey"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/imgCalendar"
            app:layout_constraintStart_toEndOf="@id/imgCalendar"
            app:layout_constraintTop_toTopOf="@id/imgCalendar" />

        <TextView
            android:id="@+id/tvServiceType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_bold"
            android:text="PREVENTIVO"
            android:textColor="@color/ube"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>