<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chinese_black">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0"
        android:src="@drawable/logo_climatrack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <LinearLayout
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo">

        <View
            android:id="@+id/square1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_loader_square" />

        <View
            android:id="@+id/square2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_loader_square" />

        <View
            android:id="@+id/square3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_loader_square" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/geist"
        android:text="Versión 1.0 Académica"
        android:textColor="@color/cadet_grey"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>