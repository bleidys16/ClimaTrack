<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvStatRank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_nav_item_selected_pill"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/chinese_black"
        android:textSize="12sp"
        android:fontFamily="@font/geist_bold" />

    <TextView
        android:id="@+id/tvStatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="Nombre del Item"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/geist_medium" />

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textColor="@color/ube"
        android:textSize="16sp"
        android:fontFamily="@font/geist_bold" />

</LinearLayout>
