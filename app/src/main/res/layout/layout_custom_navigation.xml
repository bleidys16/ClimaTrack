<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/american_blue"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            android:paddingHorizontal="4dp">
            <ImageView
                android:id="@+id/iv_home"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/cadet_grey" />
            <TextView
                android:id="@+id/tv_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Orders -->
        <LinearLayout
            android:id="@+id/nav_orders"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="4dp">
            <ImageView
                android:id="@+id/iv_orders"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_orders"
                app:tint="@color/cadet_grey" />
            <TextView
                android:id="@+id/tv_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Órdenes"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Equipment -->
        <LinearLayout
            android:id="@+id/nav_equipment"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="4dp">
            <ImageView
                android:id="@+id/iv_equipment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_equipment"
                app:tint="@color/cadet_grey" />
            <TextView
                android:id="@+id/tv_equipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipos"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/nav_history"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="4dp">
            <ImageView
                android:id="@+id/iv_history"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/cadet_grey" />
            <TextView
                android:id="@+id/tv_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/white"
                android:fontFamily="@font/geist_bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>